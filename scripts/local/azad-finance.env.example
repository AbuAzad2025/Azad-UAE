# scripts/local/azad-finance.env - LOCAL CONFIGURATION, NEVER COMMITTED.
#
# Copy this file, fill it in, and the launcher will read it. Everything here
# is a secret: the database URL carries the database password, and
# OWNER_PASSWORD is the platform owner's account.
#
#   DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/Azad-Finance
#   OWNER_PASSWORD=YOUR_OWNER_PASSWORD
#   SECRET_KEY=leave-empty-to-generate-one-per-machine
#
# The file is listed in .gitignore, so it never reaches the repository.

DATABASE_URL=
OWNER_PASSWORD=
SECRET_KEY=
