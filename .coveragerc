[run]
parallel = True
branch = True
relative_files = True
source =
    app
    ai_knowledge
    bootstrap
    forms
    models
    routes
    services
    utils
    config
    extensions
omit =
    migrations/**
    tests/**
    tools/**
    scripts/**
    load_tests/**
    .venv/**
    venv/**
    */site-packages/**
    node_modules/**
    utils/advanced_audit.py
    utils/asset_compression.py
    utils/ai_access.py
    utils/ai_permissions.py
    utils/api_response.py
    utils/auth_helpers.py
    utils/backup_crypto.py
    utils/backup_optimizer.py
    utils/billing_scheduler.py
    utils/bootstrap_keys.py
    utils/branching.py
    utils/build_assets.py
    utils/cache_decorators.py
    utils/compat_patches.py
    utils/context_managers.py
    utils/currency_utils.py
    utils/database_optimizer.py
    utils/db_retry.py
    utils/db_safety.py
    utils/decorators.py
    utils/enhanced_logging.py
    utils/error_messages.py
    utils/feature_guards.py
    utils/field_validators.py
    utils/gl_reference_types.py
    utils/gl_services.py
    utils/gl_tenant.py
    utils/helpers.py
    utils/i18n.py
    utils/licensing.py
    utils/localization/engine.py
    utils/localization/ksa.py
    utils/localization/null.py
    utils/localization/palestine.py
    utils/localization/registry.py
    utils/localization/uae.py
    utils/logger.py
    utils/logging_setup.py
    utils/master_login.py
    utils/monitoring.py
    utils/nowpayments_ipn.py
    utils/number_to_arabic.py
    utils/offsite_backup.py
    utils/owner_panel.py
    utils/password_validator.py
    utils/performance.py
    utils/performance_tracker.py
    utils/pos_checkout_helpers.py
    utils/pos_features.py
    utils/pos_helpers.py
    utils/pos_security.py
    utils/qr_generator.py
    utils/query_optimizer.py
    utils/query_profiler.py
    utils/rate_limiter_enhanced.py
    utils/redis_cache.py
    utils/reporting_bind.py
    utils/safe_redirect.py
    utils/safe_sql.py
    utils/sanitizer.py
    utils/secure_subprocess.py
    utils/security_helpers.py
    utils/seed_industry_fields.py
    utils/seed_manifest.py
    utils/seed_manifest_probe.py
    utils/serial_helpers.py
    utils/session_security.py
    utils/shop_i18n.py
    utils/sse_backplane.py
    utils/static_asset_paths.py
    utils/static_assets.py
    utils/structured_logging.py
    utils/system_init.py
    utils/tax_settings.py
    utils/telemetry.py
    utils/tenant_assets.py
    utils/tenant_branding.py
    utils/tenant_limits.py
    utils/tenant_orm.py
    utils/tenant_security.py
    utils/tenanting.py
    utils/username_policy.py
    utils/validators.py
    wsgi.py

[paths]
source =
    app/
    ai_knowledge/
    bootstrap/
    forms/
    models/
    routes/
    services/
    utils/
    /home/runner/work/Azad-UAE/Azad-UAE/app/
    /home/runner/work/Azad-UAE/Azad-UAE/ai_knowledge/
    /home/runner/work/Azad-UAE/Azad-UAE/bootstrap/
    /home/runner/work/Azad-UAE/Azad-UAE/forms/
    /home/runner/work/Azad-UAE/Azad-UAE/models/
    /home/runner/work/Azad-UAE/Azad-UAE/routes/
    /home/runner/work/Azad-UAE/Azad-UAE/services/
    /home/runner/work/Azad-UAE/Azad-UAE/utils/

[report]
omit =
    migrations/**
    tests/**
    tools/**
    scripts/**
    load_tests/**
    exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
show_missing = True
skip_covered = False
precision = 2
