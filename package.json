{
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pytest tests/e2e --ignore=tests/e2e/tours -q",
		"test:e2e:all": "pytest tests/e2e -q",
		"test:tours": "npx playwright test --config=scripts/playwright.config.json --reporter=list",
		"test:tours:ci": "npx playwright test --config=scripts/playwright.config.json --reporter=list",
		"css:purge": "node scripts/lint/purgecss-report.js",
		"css:build": "postcss \"static/css/*.css\" --dir static/css/dist --config postcss.config.js",
		"css:minify": "postcss \"static/css/dist/*.css\" --dir static/css/dist --config postcss.config.min.js",
		"js:minify": "node scripts/build/minify-js.js",
		"build:assets": "npm run css:build && npm run css:minify && npm run js:minify",
		"build:prod": "npm run build:assets && npm run css:purge"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@vitest/coverage-v8": "^4.1.11",
		"cssnano": "^9.0.1",
		"jsdom": "^30.0.1",
		"postcss": "^8.4.47",
		"postcss-cli": "^11.0.0",
		"postcss-import": "^17.0.0",
		"purgecss": "^8.0.0",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"terser": "^5.51.2",
		"vitest": "^4.1.11"
	}
}